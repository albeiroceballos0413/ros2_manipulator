<?xml version="1.0"?>
<!-- Manipulador planar RRR: L1 = 0.30, L2 = 0.25, L3 = 0.10 m (mismos valores que la tabla DH) -->
<robot name="rrr_arm">

  <material name="gris"><color rgba="0.55 0.55 0.55 1"/></material>
  <material name="azul"><color rgba="0.10 0.40 0.80 1"/></material>
  <material name="naranja"><color rgba="0.95 0.50 0.10 1"/></material>
  <material name="verde"><color rgba="0.20 0.70 0.30 1"/></material>
  <material name="rojo"><color rgba="0.85 0.10 0.10 1"/></material>

  <!-- Base fija -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 -0.04" rpy="0 0 0"/>
      <geometry><cylinder radius="0.07" length="0.04"/></geometry>
      <material name="gris"/>
    </visual>
  </link>

  <!-- Eslabón 1 (L1 = 0.30 m): la caja va centrada en L1/2 a lo largo de x -->
  <link name="link1">
    <visual>
      <origin xyz="0.15 0 0" rpy="0 0 0"/>
      <geometry><box size="0.30 0.04 0.03"/></geometry>
      <material name="azul"/>
    </visual>
    <visual>
      <geometry><cylinder radius="0.03" length="0.05"/></geometry>
      <material name="gris"/>
    </visual>
  </link>

  <!-- Eslabón 2 (L2 = 0.25 m) -->
  <link name="link2">
    <visual>
      <origin xyz="0.125 0 0" rpy="0 0 0"/>
      <geometry><box size="0.25 0.035 0.03"/></geometry>
      <material name="naranja"/>
    </visual>
    <visual>
      <geometry><cylinder radius="0.025" length="0.05"/></geometry>
      <material name="gris"/>
    </visual>
  </link>

  <!-- Eslabón 3 (L3 = 0.10 m) -->
  <link name="link3">
    <visual>
      <origin xyz="0.05 0 0" rpy="0 0 0"/>
      <geometry><box size="0.10 0.03 0.03"/></geometry>
      <material name="verde"/>
    </visual>
    <visual>
      <geometry><cylinder radius="0.02" length="0.05"/></geometry>
      <material name="gris"/>
    </visual>
  </link>

  <!-- Efector final (punta) -->
  <link name="ee_link">
    <visual>
      <geometry><sphere radius="0.02"/></geometry>
      <material name="rojo"/>
    </visual>
  </link>

  <!-- Articulaciones: cada una gira en z y está a L_i de la anterior (igual que DH: a_i = L_i) -->
  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="10.0" velocity="2.0"/>
  </joint>

  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0.30 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="10.0" velocity="2.0"/>
  </joint>

  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0.25 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="10.0" velocity="2.0"/>
  </joint>

  <joint name="ee_joint" type="fixed">
    <parent link="link3"/>
    <child link="ee_link"/>
    <origin xyz="0.10 0 0" rpy="0 0 0"/>
  </joint>

</robot>
